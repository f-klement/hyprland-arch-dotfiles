// ### Proposal 3 — "Semantic": same three blocks, every module wears its own Rose Pine accent ### //
{
    "include": "~/.config/waybar/modules",
    "reload_style_on_change": true,
    "layer": "top",
    "output":["eDP-1","Dell Inc. DELL P2319H 9K41KM3"],
    "height": 28,
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    "spacing": 0,
    "fixed-center": true,
    "ipc": true,
    "margin-top": 2,
    "margin-left": 4,
    "margin-right": 4,

    "modules-left": [
     "hyprland/workspaces#roman",
     "custom/separator#dot-line",
     "wlr/taskbar",
     "custom/weather"
     ],

    "modules-center": [
     "custom/menu",
     "custom/separator#dot-line",
     "idle_inhibitor",
     "custom/separator#dot-line",
     "clock",
     "custom/separator#dot-line",
     "custom/light_dark",
     "custom/separator#dot-line",
     "custom/lock"
     ],

    "modules-right": [
     "custom/swaync",
     "tray",
     "mpris",
     "bluetooth",
     "custom/separator#dot-line",
     "battery",
     "custom/separator#dot-line",
     "pulseaudio",
     "custom/separator#dot-line",
     "custom/power"
     ],
}
