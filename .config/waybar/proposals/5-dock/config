// ### Proposal 5 — "Dock": bottom bar, app-centric island in the middle ### //
{
    "include": "~/.config/waybar/modules",
    "reload_style_on_change": true,
    "layer": "top",
    "output":["eDP-1","Dell Inc. DELL P2319H 9K41KM3"],
    "height": 34,
    "exclusive": true,
    "passthrough": false,
    "position": "bottom",
    "spacing": 0,
    "fixed-center": true,
    "ipc": true,
    "margin-bottom": 4,
    "margin-left": 8,
    "margin-right": 8,

    // bigger app icons for the dock (main config overrides the included key)
    "wlr/taskbar": { "icon-size": 20 },
    "tray": { "icon-size": 16 },

    // left corner: time + context
    "modules-left": [
     "clock",
     "custom/separator#dot-line",
     "custom/weather",
     "custom/separator#dot-line",
     "mpris"
     ],

    // the dock: launcher, workspaces, running apps
    "modules-center": [
     "custom/menu",
     "custom/separator#dot-line",
     "hyprland/workspaces#roman",
     "custom/separator#dot-line",
     "wlr/taskbar"
     ],

    // right corner: status + session
    "modules-right": [
     "custom/swaync",
     "tray",
     "bluetooth",
     "custom/separator#dot-line",
     "battery",
     "custom/separator#dot-line",
     "pulseaudio",
     "custom/separator#dot-line",
     "idle_inhibitor",
     "custom/light_dark",
     "custom/lock",
     "custom/separator#dot-line",
     "custom/power"
     ],
}
