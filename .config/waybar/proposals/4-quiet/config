// ### Proposal 4 — "Quiet": a low-contrast 24px strip, only state changes light up ### //
{
    "include": "~/.config/waybar/modules",
    "reload_style_on_change": true,
    "layer": "top",
    "output":["eDP-1","Dell Inc. DELL P2319H 9K41KM3"],
    "height": 24,
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    // wider spacing does the separating; the dot-line glyphs are faded
    "spacing": 4,
    "fixed-center": true,
    "ipc": true,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    // smaller taskbar icons to suit the 24px bar (main config wins over
    // the included modules file, only this key is overridden)
    "wlr/taskbar": { "icon-size": 13 },
    "tray": { "icon-size": 13, "spacing": 6 },

    "modules-left": [
     "hyprland/workspaces#roman",
     "custom/separator#dot-line",
     "wlr/taskbar",
     "custom/weather"
     ],

    "modules-center": [
     "custom/menu",
     "custom/separator#dot-line",
     "idle_inhibitor",
     "custom/separator#dot-line",
     "clock",
     "custom/separator#dot-line",
     "custom/light_dark",
     "custom/separator#dot-line",
     "custom/lock"
     ],

    "modules-right": [
     "custom/swaync",
     "tray",
     "mpris",
     "bluetooth",
     "custom/separator#dot-line",
     "battery",
     "custom/separator#dot-line",
     "pulseaudio",
     "custom/separator#dot-line",
     "custom/power"
     ],
}
