// ### Proposal 2 — "Archipelago": many small islands instead of three blocks ### //
{
    "include": "~/.config/waybar/modules",
    "reload_style_on_change": true,
    "layer": "top",
    "output":["eDP-1","Dell Inc. DELL P2319H 9K41KM3"],
    "height": 30,
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    "spacing": 0,
    "fixed-center": true,
    "ipc": true,
    "margin-top": 3,
    "margin-left": 6,
    "margin-right": 6,

    // Islands are waybar groups (their CSS id is the name after "group/",
    // e.g. #island-ws). The dot-line separators sit *between* islands and
    // are styled as invisible spacers -- still present, so the shared
    // modules file needs no changes.
    "group/island-ws":     { "orientation": "horizontal", "modules": ["hyprland/workspaces#roman"] },
    "group/island-apps":   { "orientation": "horizontal", "modules": ["wlr/taskbar", "custom/weather"] },
    "group/island-core":   { "orientation": "horizontal", "modules": ["idle_inhibitor", "clock", "custom/light_dark"] },
    "group/island-notify": { "orientation": "horizontal", "modules": ["custom/swaync", "tray", "mpris"] },
    "group/island-hw":     { "orientation": "horizontal", "modules": ["bluetooth", "battery", "pulseaudio"] },

    "modules-left": [
     "group/island-ws",
     "custom/separator#dot-line",
     "group/island-apps"
     ],

    "modules-center": [
     "custom/menu",
     "custom/separator#dot-line",
     "group/island-core",
     "custom/separator#dot-line",
     "custom/lock"
     ],

    "modules-right": [
     "group/island-notify",
     "custom/separator#dot-line",
     "group/island-hw",
     "custom/separator#dot-line",
     "custom/power"
     ],
}
