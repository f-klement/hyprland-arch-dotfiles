// ### Proposal 1 — "Solid": one full-width panel, no floating islands ### //
{
    "include": "~/.config/waybar/modules",
    "reload_style_on_change": true,
    "layer": "top",
    // no "output" filter: bar on every connected monitor (home + work docks)
    "height": 28,
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    "spacing": 0,
    "fixed-center": true,
    "ipc": true,
    // edge-to-edge: the panel IS the top edge of the screen
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
     "hyprland/workspaces#roman",
     "custom/separator#dot-line",
     "wlr/taskbar",
     "custom/weather"
     ],

    "modules-center": [
     "custom/menu",
     "custom/separator#dot-line",
     "idle_inhibitor",
     "custom/separator#dot-line",
     "clock",
     "custom/separator#dot-line",
     "custom/light_dark",
     "custom/separator#dot-line",
     "custom/lock"
     ],

    "modules-right": [
     "custom/swaync",
     "tray",
     "mpris",
     "bluetooth",
     "custom/separator#dot-line",
     "battery",
     "custom/separator#dot-line",
     "pulseaudio",
     "custom/separator#dot-line",
     "custom/power"
     ],
}
