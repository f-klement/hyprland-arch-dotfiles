<?xml version="1.0" encoding="UTF-8"?>
<!-- Right-click menu for the "bluetooth" waybar module (see waybar/modules).
     Same reasoning as network_menu.xml: the radio toggle lives behind a
     menu click, not a bare on-click. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="toggle">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Toggle Bluetooth</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="manager">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Bluetooth Manager</property>
      </object>
    </child>
  </object>
</interface>
