
// ### DEFAULT Top -Laptop ### //
{
    "include": "~/.config/waybar/modules",
    // Added (2026-09-11): waybar can watch style.css itself for changes
    // and hot-reload without a restart. DarkLight.sh's theme toggle only
    // ever swaps style.css's symlink target (never config/modules), so
    // this should mean it no longer needs to kill+relaunch waybar at all --
    // see scripts/DarkLight.sh for the other half of that fix. Restarting
    // waybar was also what reset the idle_inhibitor ("caffeine" toggle) on
    // every theme switch, same root cause as the wallpaper-rotation bug
    // fixed earlier this session.
    "reload_style_on_change": true,
    "layer": "top",
    //"mode": "dock",
    "output":["eDP-1","Dell Inc. DELL P2319H 9K41KM3"],
    "height": 28,
    "exclusive": true,
    "passthrough": false,
    "position": "top",
    "spacing": 0,
    "fixed-center": true,
    "ipc": true,
    "margin-top": 1,
    "margin-left": 3,
    "margin-right": 3,
    
    "modules-left": [
