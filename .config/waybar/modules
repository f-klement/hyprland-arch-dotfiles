// Power mode: auto / performance / power saver (left-click cycles).
// Auto follows AC/battery and only toggles Hyprland's blur -- tccd keeps
// switching its own CPU/fan profile natively either way. Right-click opens
// the existing TCC profile picker for a manual hardware-profile override.
"custom/power_mode": {
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/PowerMode.sh --status",
    "on-click": "~/.config/hypr/scripts/PowerMode.sh --cycle",
    "on-click-right": "tuxedo-control-center",  // the detailed app; the pane itself is on the battery module
    "signal": 8,
    "interval": 15, // fallback poll, in case AC/battery changes while nothing else triggers a redraw
    "tooltip": true
},

