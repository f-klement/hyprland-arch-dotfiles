"bluetooth": {
    // Rewritten (2026-09-11): the old block only ever defined
    // format-disabled and format-connected -- format defaulted to "" (an
    // intentionally-empty fallback), so the very common "powered on, idle,
    // nothing connected" state, and the radio-off state produced by the
    // menu's own toggle below, both fell through to that empty default and
    // the icon just disappeared. Now every state waybar-bluetooth(5)
    // recognizes (on/off/disabled/no-controller/connected) has its own
    // icon, so the module always shows something and is never a dead end.
    // All icons below are glyphs already proven to render in this exact
    // font/config (reused from this module's own original format-disabled/
    // format-connected and from pulseaudio's format-bluetooth) rather than
    // new codepoints, to avoid guessing wrong and getting tofu boxes.
    //
    // Tooltip was just " {device_alias}" by default, which is only
    // meaningful when a device is actually connected -- blank/unhelpful
    // the rest of the time. Now uses {controller_alias}/{controller_address}
    // (the adapter itself) as the baseline, so hovering always tells you
    // which adapter you have and its state, not just silence.
    "format": "󰂰",
    "format-on": "󰂰",
    "format-off": "󰂳",
    "format-disabled": "󰂳",
    "format-no-controller": "󰂳",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-off": "{controller_alias}  {controller_address}\nPowered off",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-no-controller": "No bluetooth controller found",
    "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "󰂰 {device_alias}  {device_address}",
    "tooltip-format-enumerate-connected-battery": "󰂰 {device_alias}  {device_address}  󰂄{device_battery_percentage}%",
    "tooltip": true,
    // Consolidated (2026-09-11): blueman-tray's own SNI icon (org.blueman.Tray)
    // was showing up as a second bluetooth icon in waybar's tray module,
    // duplicating this one -- disabled at the source (blueman's StatusIcon
    // plugin, see gsettings org.blueman.general plugin-list) since this
    // module already shows more out of the box (connected count, per-device
    // battery %, adapter info on hover).
    //
    // Clicks (2026-09-15): left = quick pane (power switch, known devices
    // with connect/disconnect + battery, short scan), right = blueman-manager
    // for pairing and everything else. The XML menu that used to sit on
    // right-click (menus/bluetooth_menu.xml) is superseded by the pane.
    "on-click": "~/.config/hypr/UserScripts/BluetoothPane.py",
    "on-click-right": "blueman-manager",
},

"clock": {
    "interval": 1,
    //"format": " {:%I:%M %p}", // AM PM format
    "format": " {:%H:%M:%S}",
    "format-alt": " {:%H:%M   %Y, %d %B, %A}",
    // tooltip is just the date now -- the flip-out calendar lives in the
    // pane (2026-09-15); the "calendar" block below only feeds {calendar},
    // which nothing shows any more, kept in case the tooltip is ever restored.
    "tooltip-format": "{:%A, %d. %B %Y}",
    "calendar": {
        "mode"          : "year",
        "mode-mon-col"  : 3,
        "weeks-pos"     : "right",
        "on-scroll"     : 1,
        "format": {
            "months":     "<span color='#ffead3'><b>{}</b></span>",
            "days":       "<span color='#ecc6d9'><b>{}</b></span>",
            "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
            "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
            "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
    },
    // BUG FIXED (2026-09-15): the closing brace after "calendar" used to be
    // "}," one level too many, closing the clock module itself -- so the
    // "actions" block (with its on-click-right: "mode") and anything after
    // it were top-level keys waybar silently ignored. Re-indented and fixed.
    //
    // left: toggle the full-date format (format-alt); right: calendar pane
    // (month grid + the day's events read from Thunderbird's calendar
    // cache, UserScripts/CalendarPane.py) -- Thunderbird itself is a button
    // in there.
    "format-alt-click": "click",
    "on-click-right": "~/.config/hypr/UserScripts/CalendarPane.py",
    "actions":  {
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    },
},

