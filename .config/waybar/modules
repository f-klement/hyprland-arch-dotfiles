"custom/weather": {
    // Open-Meteo via hypr/UserScripts/Weather.py (was wttr.in until 2026-09-15).
    // The script caches for 15 min, hides itself when there's no usable
    // data and shows old data dimmed (class "stale") while the API is down.
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/hypr/UserScripts/Weather.py",
    "interval": 900,
    // left + right: forecast pane (toggles: a 2nd launch closes it); middle:
    // force a refresh. windy.com is only reachable from the pane's button.
    "signal": 9,
    "on-click": "~/.config/hypr/UserScripts/Weather.py --pane",
    "on-click-right": "~/.config/hypr/UserScripts/Weather.py --pane",
    "on-click-middle": "~/.config/hypr/UserScripts/Weather.py -f >/dev/null; pkill -RTMIN+9 waybar",
    "tooltip" : true,
},
  
  
