"network": {
    "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰌘",
    "format-disconnected": "󰌙",
    // Was missing entirely -- waybar-network(5) uses format-disabled
    // specifically for "rfkill is blocking wlan interfaces" (the "rfkill"
    // option defaults to true), which is exactly the state the menu's
    // toggle below produces. Without it defined, that state fell through
    // to the bare "format" above ("{ifname}"), which is blank once the
    // interface is radio-blocked -- so the icon just vanished
    // (2026-09-11 report). Reusing the disconnected glyph rather than a
    // new codepoint.
    "format-disabled": "󰌙",
    "tooltip-format": "{ipaddr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} 󰌘",
    "tooltip-format-disconnected": "󰌙 Disconnected",
    "tooltip-format-disabled": "󰌙 Wi-Fi disabled",
    "max-length": 50,
    "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
    // Consolidated (2026-09-11): nm-applet's own SNI tray icon was
    // showing up as a second network icon in waybar's tray module,
    // duplicating this one -- nm-applet isn't autostarted anymore at all
    // (no flag makes it register invisibly, see hypr/autostart.lua for why)
    // since this module already shows more out of the box (essid, signal
    // strength, ipaddr, live bandwidth) than the applet icon ever did.
    //
    // Went through two more iterations of click behavior the same day:
    // 1) bare left-click toggled the radio via rfkill (AirplaneMode.sh) --
    //    a single stray click disabled Wi-Fi with no confirmation, and
    //    rfkill operates below NetworkManager, so re-enabling didn't
    //    reliably reconnect (NM's own state fell out of sync with it).
    // 2) moved the toggle behind waybar's native right-click menu (see the
    //    now-unused menus/network_menu.xml) and made left-click open
    //    nm-connection-editor -- safer, but nm-connection-editor is a
    //    connection-*profile* editor, not a live network picker, so it had
    //    nothing useful for the everyday case (switch SSID, check signal).
    // Settled on NetworkMenu.sh (rofi): a live SSID list with signal/lock
    // status, one click to (re)connect, and the toggle now goes through
    // `nmcli radio wifi` instead of rfkill, so it stays in sync with
    // NetworkManager and reconnects properly. Right-click still opens the
    // full editor directly for anything actually needing profile-level
    // configuration.
    "on-click": "~/.config/hypr/scripts/NetworkMenu.sh",
    "on-click-right": "nm-connection-editor",
},
  
