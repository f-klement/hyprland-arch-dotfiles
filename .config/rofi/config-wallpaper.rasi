/* Wallpaper picker (WallpaperSelect.sh, SUPER+W) -- thumbnail grid. */

configuration {
    modi: "drun,run,filebrowser";
}

@import "pywal-color/pywal-theme.rasi"
@import "theme/base.rasi"

window {
    width: 700px;
}

listview {
    columns: 4;
    lines:   4;
}

element-icon {
    size: 130px;
}
