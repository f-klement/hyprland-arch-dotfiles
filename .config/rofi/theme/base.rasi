/*
 * Shared rofi structure/style -- rebuilt from scratch (2026-09-11).
 *
 * Every config-*.rasi variant (launcher, wallpaper picker, clipboard,
 * waybar style/layout switchers, zsh theme picker, "Beats" picker, and the
 * small single-column menus like the power-profile switcher) used to carry
 * its own ~200-line copy of this, identical except for window size and
 * listview columns/lines. Nine copies drifting independently is how a
 * theme ends up "ugly" and inconsistent one variant at a time without
 * anyone noticing -- this file holds the actual design once; each variant
 * now just @imports the color file, @imports this, and overrides only
 * `window { width/height }` and `listview { columns/lines }` where it
 * actually needs to differ. Colors all come from the imported color file
 * (pywal-color/tokyo-night.rasi or rose-pine.rasi, switched by
 * DarkLight.sh) -- nothing here is theme-specific.
 *
 * Design, compared to the old per-file copies:
 * - One accent color for border + selection + active mode, not two
 *   (the color files themselves were the actual bug -- see their own
 *   headers -- but a shared base makes "one accent, used consistently"
 *   something you only have to get right once).
 * - Borders removed from every inner widget (inputbar/listbox/buttons all
 *   had their own 1px accent border before, on top of the window's) --
 *   left only on the outer window, everything inside reads as one panel
 *   instead of a stack of boxed-in widgets.
 * - Dropped the emoji prompt icon; a plain accent-colored caret instead.
 * - Selection highlight is a proper rounded pill (radius matches the
 *   element radius) rather than a background color with square-ish 2px
 *   margin edges.
 *
 * configuration{} defaults below too, for the same reason -- every variant
 * had the exact same font/show-icons/mouse-binding/window-format block,
 * differing only in `modi`. Each variant now sets just that (and `width`,
 * `height`, listview `columns`/`lines`, element-icon `size` below it,
 * where it differs from these defaults).
 */

configuration {
    font:                "Fira Code SemiBold 14";
    show-icons:          true;
    display-drun:        "";
    display-run:         "";
    display-filebrowser: "";
    display-window:      "";
    drun-display-format: "{name}";
    hover-select:        true;
    me-select-entry:     "MouseSecondary";
    me-accept-entry:     "MousePrimary";
    window-format:       "{w} · {c} · {t}";
    dpi:                 1;
}

window {
    x-offset:           0px;
    y-offset:           0px;
    spacing:            0px;
    padding:            0px;
    margin:             0px;
    border:             2px;
    border-color:       @active-background;
    cursor:             "default";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    enabled:            true;
    border-radius:      16px;
    background-color:   @background;
}

mainbox {
    enabled:            true;
    orientation:        vertical;
    padding:            10px;
    spacing:            10px;
    background-color:   transparent;
    children:           [ "inputbar", "content" ];
    border-radius:      16px;
}

content {
    enabled:            true;
    orientation:        horizontal;
    spacing:            8px;
    background-color:   transparent;
    children:           [ "mode-switcher", "listbox" ];
}

listbox {
    enabled:            true;
    orientation:        vertical;
    background-color:   transparent;
    children:           [ "listview" ];
}

/* ---- Search bar ---- */
inputbar {
    enabled:            true;
    text-color:         @foreground;
    spacing:            8px;
    padding:            10px 14px;
    border-radius:      12px;
    background-color:   @background-alt;
    children:           [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:            true;
    expand:             false;
    str:                "❯";
    text-color:         @active-background;
    background-color:   transparent;
}

entry {
    enabled:            true;
    text-color:         inherit;
    cursor:             text;
    placeholder:        "Type to search...";
    placeholder-color:  @foreground-alt;
    background-color:   transparent;
}

/* ---- Mode switcher (drun/run/filebrowser/window tabs) ---- */
mode-switcher {
    enabled:            true;
    orientation:        vertical;
    spacing:            8px;
    background-color:   transparent;
    text-color:         @foreground;
}

button {
    padding:            8px;
    border-radius:      10px;
    background-color:   @background-alt;
    text-color:         @foreground-alt;
    cursor:             pointer;
}

button selected {
    background-color:   @active-background;
    text-color:         @active-foreground;
}

/* ---- Results ---- */
listview {
    enabled:            true;
    columns:            1;
    lines:              8;
    fixed-columns:      false;
    spacing:            6px;
    padding:            0px;
    dynamic:            true;
    cycle:              true;
    scrollbar:          true;
    layout:             vertical;
    reverse:            false;
    fixed-height:       true;
    fixed-columns:      false;
    background-color:   transparent;
    border-radius:      12px;
    border:             0px;
}

scrollbar {
    handle-color:       @active-background;
    handle-width:       4px;
    border-radius:      4px;
    padding:            0px 0px 0px 4px;
}

element {
    enabled:            true;
    padding:            8px 10px;
    margin:             0px;
    cursor:             pointer;
    background-color:   transparent;
    border-radius:      10px;
    border:             0px;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color:   inherit;
    text-color:         @foreground;
}

element selected.normal,
element selected.active {
    background-color:   @selected-normal-background;
    text-color:         @selected-normal-foreground;
}

element selected.urgent {
    background-color:   @urgent-background;
    text-color:         @urgent-foreground;
}

element-icon {
    background-color:   transparent;
    text-color:         inherit;
    size:               32px;
    cursor:             inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0;
}

/* ---- Message / error boxes (e.g. drun's "no results") ---- */
message {
    background-color:   @background-alt;
    margin:             10px 0px 0px 0px;
    border-radius:      12px;
}

textbox {
    padding:            10px;
    background-color:   transparent;
    text-color:         @foreground;
}

error-message {
    padding:            15px;
    border-radius:      12px;
    background-color:   @background-alt;
    text-color:         @foreground;
}
