/* Small single-column menu -- used for things like the power-profile switcher
 * (scripts/powerprofiles.sh) and other short action lists. */

configuration {
    modi: "drun,run";
}

@import "pywal-color/pywal-theme.rasi"
@import "theme/base.rasi"

window {
    width: 500px;
}

listview {
    lines: 7;
}
