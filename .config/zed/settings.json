// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_size": 13.0
  },
  "ssh_connections": [
    {
      "host": "pelican",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/francisdrake"
          ]
        }
      ]
    }
  ],
  "project_panel": {
    "default_width": 220.0,
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "outline_panel": {
    "dock": "left"
  },
  "window_decorations": "client",
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_sign_in": false,
    "show_branch_status_icon": false
  },
  "prettier": {
    "allowed": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": "Catppuccin Macchiato",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night Storm",
  },
}
